# Maintainer: JungWoo <ijungwoo02@outlook.com>

pkgname=omabeam
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Beam text, links, or one file to a phone with a QR code"
arch=('x86_64')
url="https://github.com/Choi-Jungwoo/omabeam"
license=('MIT')
options=('!debug')
depends=('glibc' 'libgcc' 'iproute2' 'wl-clipboard')
optdepends=('omarchy: floating terminal and desktop integration')
makedepends=('rust')
install=omabeam.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/omabeam "$pkgdir/usr/bin/omabeam"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 packaging/omarchy/menu-entry.jsonc \
    "$pkgdir/usr/share/$pkgname/omarchy/menu-entry.jsonc"
  install -Dm644 packaging/omarchy/keybinding.lua \
    "$pkgdir/usr/share/$pkgname/omarchy/keybinding.lua"
}
